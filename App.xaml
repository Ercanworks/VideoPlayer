<Application x:Class="Oynatici.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- The accent color is taken from Windows' own accent color at startup -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
        <!-- Light shade of the accent color ("light 1" in the Windows palette); Movies & TV uses it for the bars in dark theme -->
        <SolidColorBrush x:Key="AccentLightBrush" Color="#429CE3" />
        <SolidColorBrush x:Key="TrackBrush" Color="#29FFFFFF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="PressedBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="FlyoutBrush" Color="#F22B2B2B" />
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!-- Rounded icon buttons on the control bar -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window buttons in the top right (minimize, maximize, close) -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Tag" Value="{StaticResource HoverBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Square buttons on the bottom bar (like Movies & TV). The border color is set from code, by a light
             that follows the cursor (RadialGradientBrush): edges glow as the mouse gets closer -->
        <Style x:Key="RevealButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <!-- Movies & TV: all icons 20 pt, boxes 48x48, 2 px apart -->
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <!-- In Movies & TV the icons sit 1 px below the box center -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play/pause: the same square as the others, slightly larger icon -->
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource RevealButton}">
            <Setter Property="FontSize" Value="20" />
        </Style>

        <!-- Previous/next video arrows at the edges (measured from Movies & TV): 30x100 box,
             80% white arrow, 1 px shadow at the bottom right; the border appears with the light following the cursor,
             18% white fill while pressed -->
        <Style x:Key="EdgeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B0FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="24" />
            <!-- In Movies & TV the box is 1 px below center -->
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="100" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Effect>
                                    <DropShadowEffect Color="Black" Direction="315" ShadowDepth="1"
                                                      BlurRadius="3" Opacity="0.55" />
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows in popup menus -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlyoutBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FlyoutBrush}" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <!-- Seek and volume bars: thin track, thumb that grows on hover -->
        <!-- Bars measured from Movies & TV: the elapsed part is 4 px light accent color, the rest 2 px
             translucent gray, the thumb a 20 px hollow ring (does not grow on hover) -->
        <Style x:Key="FlatRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="{TemplateBinding Height}" VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FlatRepeat}" Background="{DynamicResource AccentLightBrush}"
                                                  Command="{x:Static Slider.DecreaseLarge}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FlatRepeat}" Background="{StaticResource TrackBrush}"
                                                  Height="2" Command="{x:Static Slider.IncreaseLarge}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- The overlay size is fixed at 20 px; while pressed the circle grows to 22 px and overflows,
                                                     so the bar's layout doesn't shift -->
                                                <Grid Width="20" Height="20" Background="Transparent">
                                                    <Ellipse x:Name="Ring" Width="20" Height="20"
                                                             Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="2" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <!-- Filled while pressed (and while dragging), like Movies & TV -->
                                                    <DataTrigger Binding="{Binding IsMouseCaptured, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                        <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AccentLightBrush}" />
                                                        <Setter TargetName="Ring" Property="Width" Value="22" />
                                                        <Setter TargetName="Ring" Property="Height" Value="22" />
                                                        <Setter TargetName="Ring" Property="Margin" Value="-1" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
