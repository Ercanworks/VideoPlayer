<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 APIs: media keys / Windows media controls and Windows subtitle settings -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>VideoPlayer</AssemblyName>
    <RootNamespace>Oynatici</RootNamespace>
    <Product>Video Player</Product>
    <Version>1.11.1</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- mpv engine (github.com/shinchiro/mpv-winbuild-cmake, 20261004) -->
    <!-- Not in the repo because GitHub doesn't accept files over 100 MB; tools\libmpv-indir.ps1 downloads it -->
    <None Include="lib\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('lib\libmpv-2.dll')" />
  </ItemGroup>

</Project>
