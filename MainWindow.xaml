<Window x:Class="Oynatici.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Oynatici"
        Title="Video Player" Width="1100" Height="650" MinWidth="360" MinHeight="220"
        Background="Black" AllowDrop="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Windows'un başlık çubuğu yok; pencere düğmeleri videonun üstünde, kontrollerle birlikte gizlenir -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="Black">
        <!-- Motorun görüntüyü çizdiği yerel pencere -->
        <local:VideoHost x:Name="Video" />

        <!-- Kontroller. Video ayrı bir yerel pencere olduğu için WPF öğeleri üstünde görünemez;
             bu ızgara açılışta videonun üstündeki saydam bir pencereye taşınır.
             Neredeyse saydam arka plan: videonun üstündeki tıklamaları yakalamak için -->
        <Grid x:Name="Overlay" Background="#01000000" AllowDrop="True"
              TextElement.Foreground="White" TextElement.FontFamily="Segoe UI">

            <!-- Açılış ekranı -->
            <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="56"
                           HorizontalAlignment="Center" Opacity="0.8" />
                <TextBlock Text="{x:Static local:L.DropHere}" FontSize="20" Margin="0,18,0,6"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static local:L.Or}" FontSize="14" Opacity="0.6" HorizontalAlignment="Center" />
                <Button x:Name="OpenButton" Margin="0,10,0,0" HorizontalAlignment="Center" Height="36"
                        Focusable="False" Cursor="Hand" Click="OpenButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="24,0">
                                <TextBlock Text="{x:Static local:L.ChooseFile}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Ortada kısa süre görünen bildirim (ses, ileri sarma vb.) -->
            <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#B3000000" CornerRadius="8" Padding="22,14" Opacity="0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" FontFamily="{StaticResource IconFont}" FontSize="22" VerticalAlignment="Center" />
                    <TextBlock x:Name="ToastText" FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center"
                               MaxWidth="420" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Üst şerit: pencereyi taşımak için tutulan alan ve pencere düğmeleri -->
            <Grid x:Name="TopBar" VerticalAlignment="Top" Height="48">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#80000000" Offset="0" />
                        <GradientStop Color="#01000000" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            ToolTip="{x:Static local:L.Minimize}" Click="MinButton_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            ToolTip="{x:Static local:L.Maximize}" Click="MaxButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="&#xE8BB;"
                            ToolTip="{x:Static local:L.Close}" Tag="#E81123" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Klasördeki önceki/sonraki video okları: kenarlarda, dikeyde ortada; kontrollerle
                 birlikte belirip gizlenir, o yönde video yoksa hiç görünmez (Filmler ve TV gibi) -->
            <Grid x:Name="EdgeArrows">
                <Button x:Name="PrevButton" Style="{StaticResource EdgeButton}" Content="&#xE76B;"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        ToolTip="{x:Static local:L.PreviousVideoTip}" Click="PrevButton_Click" />
                <Button x:Name="NextButton" Style="{StaticResource EdgeButton}" Content="&#xE76C;"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip="{x:Static local:L.NextVideoTip}" Click="NextButton_Click" />
            </Grid>

            <!-- Duraklatılmışken fare oynayınca görünen video adı ve onunla gelen koyu gölge.
                 Ölçüler Filmler ve TV'den: gölge alttan 320 px, alttaki 150 px'te %60 siyah;
                 yazı alttan 157 px'te biter (tam ekranda 173), 34 punto ince yazı -->
            <Rectangle x:Name="TitleShade" VerticalAlignment="Bottom" Height="320" Opacity="0" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#99000000" Offset="0.53" />
                        <GradientStop Color="#99000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock x:Name="BigTitle" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                       Margin="23,0,24,147" FontSize="34" FontFamily="Segoe UI Semilight" TextOptions.TextFormattingMode="Ideal"
                       TextTrimming="CharacterEllipsis" Opacity="0" IsHitTestVisible="False" />

            <!-- Alt kontrol çubuğu -->
            <Grid x:Name="Controls" VerticalAlignment="Bottom">

                <!-- Kontrollerin arkasındaki gölge (Filmler ve TV'den ölçüldü): alttan 200 px
                     yukarıda başlar, alttaki 60 px'te %55 siyah -->
                <Rectangle x:Name="ControlsShade" VerticalAlignment="Bottom" Height="200"
                           IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#8C000000" Offset="0.7" />
                            <GradientStop Color="#8C000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid VerticalAlignment="Bottom">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- İlerleme çubuğu (tam genişlik) ve altında süreler, Filmler ve TV gibi -->
                <Grid Grid.Row="0" Margin="24,0" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Slider x:Name="Seek" Style="{StaticResource FlatSlider}" Minimum="0" Maximum="1"
                                IsEnabled="False" />
                        <!-- Sürüklerken gösterilen zaman -->
                        <Canvas IsHitTestVisible="False" ClipToBounds="False">
                            <Border x:Name="SeekTip" Background="{StaticResource FlyoutBrush}" CornerRadius="4"
                                    Padding="8,3" Canvas.Top="-30" Visibility="Collapsed">
                                <TextBlock x:Name="SeekTipText" FontSize="12" />
                            </Border>
                        </Canvas>
                    </Grid>
                    <!-- Tam sayı yükseklik: çubuk piksel sınırına otursun (yazının kendi yüksekliği 15,96 px) -->
                    <Grid Grid.Row="1" Height="16">
                        <TextBlock x:Name="TimeText" Text="00:00:00" FontSize="12" HorizontalAlignment="Left" />
                        <TextBlock x:Name="LengthText" Text="00:00:00" FontSize="12" HorizontalAlignment="Right" Margin="0,0,1,0"
                                   Cursor="Hand" ToolTip="{x:Static local:L.RemainingOrTotal}"
                                   MouseLeftButtonUp="LengthText_Click" />
                    </Grid>
                </Grid>

                <!-- Düğmeler (Filmler ve TV'den ölçüldü): ilk kutu soldan, son kutu sağdan 25 px -->
                <Grid x:Name="ButtonRow" Grid.Row="1" Margin="24,2,24,16" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="VolumeButton" Style="{StaticResource RevealButton}" Content="&#xE995;"
                                ToolTip="{x:Static local:L.VolumeTip}" Click="VolumeButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Style="{StaticResource RevealButton}" Content="&#xED3C;"
                                ToolTip="{x:Static local:L.BackTip}" Click="BackButton_Click" />
                        <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Content="&#xE768;"
                                ToolTip="{x:Static local:L.PlayTip}" Click="PlayButton_Click" />
                        <Button x:Name="ForwardButton" Style="{StaticResource RevealButton}" Content="&#xED3D;"
                                ToolTip="{x:Static local:L.ForwardTip}" Click="ForwardButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Oynatma hızı: üzerinde o anki hız yazar, tıklayınca liste açılır -->
                        <Button x:Name="SpeedButton" Style="{StaticResource RevealButton}" Content="1x"
                                FontFamily="Segoe UI" FontSize="13"
                                ToolTip="{x:Static local:L.SpeedTip}" Click="SpeedButton_Click" />
                        <Button x:Name="MiniButton" Style="{StaticResource RevealButton}" Content="&#xE8A7;"
                                ToolTip="{x:Static local:L.MiniTip}" Click="MiniButton_Click" />
                        <Button x:Name="FullButton" Style="{StaticResource RevealButton}" Content="&#xE740;"
                                ToolTip="{x:Static local:L.FullscreenTip}" Click="FullButton_Click" />
                        <Button x:Name="MoreButton" Style="{StaticResource RevealButton}" Content="&#xE712;"
                                ToolTip="{x:Static local:L.MoreTip}" Click="MoreButton_Click" />
                    </StackPanel>
                </Grid>
                </Grid>
            </Grid>

            <!-- Ses menüsü -->
            <Popup x:Name="VolumePopup" Placement="Top" VerticalOffset="-6" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Style="{StaticResource FlyoutBorder}" Padding="6,4,14,4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE995;"
                                ToolTip="{x:Static local:L.MuteTip}" Click="MuteButton_Click" />
                        <Slider x:Name="VolumeSlider" Style="{StaticResource FlatSlider}" Width="180" Minimum="0" Maximum="100"
                                VerticalAlignment="Center" Margin="6,0" ValueChanged="VolumeSlider_ValueChanged" />
                        <TextBlock x:Name="VolumeText" Text="80" Foreground="White" FontSize="14" MinWidth="28"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Oynatma hızı menüsü -->
            <Popup x:Name="SpeedPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Style="{StaticResource FlyoutBorder}" TextElement.Foreground="White">
                    <StackPanel MinWidth="160">
                        <TextBlock Text="{x:Static local:L.PlaybackSpeed}" FontSize="12" Opacity="0.6" Margin="12,8,12,4" />
                        <StackPanel x:Name="SpeedPanel" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Diğer seçenekler menüsü -->
            <Popup x:Name="MorePopup" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Style="{StaticResource FlyoutBorder}" TextElement.Foreground="White">
                    <StackPanel MinWidth="250">
                        <TextBlock Text="{x:Static local:L.WhenVideoEnds}" FontSize="12" Opacity="0.6" Margin="12,8,12,4" />
                        <Button x:Name="EndStop" Style="{StaticResource MenuButton}" Tag="Stop" Click="EndAction_Click" />
                        <Button x:Name="EndNext" Style="{StaticResource MenuButton}" Tag="Next" Click="EndAction_Click" />
                        <Button x:Name="EndRepeat" Style="{StaticResource MenuButton}" Tag="Repeat" Click="EndAction_Click" />
                        <Separator Background="#33FFFFFF" Margin="4,6" />
                        <TextBlock Text="{x:Static local:L.VideoSection}" FontSize="12" Opacity="0.6" Margin="12,4,12,4" />
                        <Button x:Name="InterpolationButton" Style="{StaticResource MenuButton}" Click="Interpolation_Click" />
                        <Separator Background="#33FFFFFF" Margin="4,6" />
                        <Button Style="{StaticResource MenuButton}" Click="MenuOpen_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" Width="28" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static local:L.OpenFile}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ShowInFolderButton" Style="{StaticResource MenuButton}" Click="ShowInFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" Width="28" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static local:L.OpenFileLocation}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MenuButton}" Click="MakeDefault_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" Width="28" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static local:L.MakeDefault}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</Window>
